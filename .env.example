PORT=4010
# segundos — cache por fonte
CACHE_TTL=300
# máximo de detalhes Meu Padrinho em paralelo por request
FETCH_CONCURRENCY=4
# csv — default: meu-padrinho,gupy,github
DEFAULT_FONTES=meu-padrinho,gupy,github
# token opcional — sobe rate limit GitHub de 60/h para 5000/h
GITHUB_TOKEN=
# repos comunitários (csv owner/repo)
GITHUB_REPOS=frontendbr/vagas,backend-br/vagas,react-brasil/vagas,python-brasil/vagas,qa-brasil/vagas
