PORT=4010

# segundos, cache por fonte

CACHE_TTL=300

# máximo de detalhes Meu Padrinho em paralelo por request

FETCH_CONCURRENCY=2

# csv, default: meu-padrinho,gupy,github,greenhouse,lever,ashby (linkedin é opt-in)

DEFAULT_FONTES=meu-padrinho,gupy,github,greenhouse,lever,ashby

# quadros públicos de ATS (csv provedor:slug)

# ATS_BOARDS=greenhouse:stone,lever:ciandt,ashby:nubank

# LinkedIn via API pública do projeto vagas-dev (open source)

VAGAS_DEV_API_URL=https://vagas-api.henriquesebastiao.com

VAGAS_DEV_ENABLED=true

# token opcional, sobe rate limit GitHub de 60/h para 5000/h

GITHUB_TOKEN=

# repos comunitários (csv owner/repo)

GITHUB_REPOS=frontendbr/vagas,backend-br/vagas,react-brasil/vagas,qa-brasil/vagas,soujava/vagas-java,dotnetdevbr/vagas,androiddevbr/vagas

